#cloud-config
autoinstall:
  version: 1
  shutdown: poweroff
  network:
    version: 2
    ethernets:
      primary:
        match:
          name: "e*"
        dhcp4: false
        addresses: [${ip_address}/${prefix_length}]
        routes:
          - to: default
            via: ${gateway}
        nameservers:
          addresses: ${jsonencode(dns_servers)}
  identity:
    hostname: ${hostname}
    username: ${ssh_user}
    password: "${login_password_hash}"
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - ${ssh_public_key}
  late-commands:
    - curtin in-target --target=/target -- touch /etc/truenas-vm-installed
  user-data:
    disable_root: true
    ssh_pwauth: true
    users:
      - default
      - name: ${ssh_user}
        groups: [adm, sudo]
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
        lock_passwd: false
        passwd: "${login_password_hash}"
        ssh_authorized_keys:
          - ${ssh_public_key}
    write_files:
      - path: /etc/ssh/sshd_config.d/99-password-authentication.conf
        permissions: "0600"
        content: |
          PasswordAuthentication yes
    package_update: true
    packages:
      - qemu-guest-agent
    runcmd:
      - [systemctl, enable, --now, qemu-guest-agent]
      - [systemctl, restart, ssh]
